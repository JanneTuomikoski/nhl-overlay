<UserControl x:Class="NHLOverlay.Controls.GameCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NHLOverlay.ViewModels"
             xmlns:controls="clr-namespace:NHLOverlay.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameCardViewModel}">
    <StackPanel>
        <TextBlock Text="{Binding SectionTitle}" Style="{StaticResource LeagueHeader}" />

        <!-- Clicking the card (interaction mode only) opens its details. -->
        <Grid Cursor="Hand" ToolTip="{Binding ToolTip}" Style="{StaticResource FavoriteCardBackground}">
            <Grid.InputBindings>
                <MouseBinding Gesture="LeftClick" Command="{Binding ToggleDetailsCommand}" />
            </Grid.InputBindings>
            <Rectangle Style="{StaticResource FavoriteBar}" />
            <StackPanel Margin="10,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" MinWidth="34" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" Source="{Binding AwayLogo}" Width="18" Height="18" Margin="0,0,6,0"
                           Style="{StaticResource TeamLogo}" />
                    <TextBlock Grid.Column="1" Text="{Binding AwayAbbrev}" FontSize="13" Style="{StaticResource AwayTeamText}" />
                    <TextBlock Grid.Column="2" Text="{Binding AwayScore}" FontSize="14" FontWeight="Bold" MinWidth="14"
                               TextAlignment="Right" Margin="4,0,0,0" Style="{StaticResource AwayTeamText}" />
                    <TextBlock Grid.Column="3" Margin="6,0" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="@" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasScore}" Value="True">
                                        <Setter Property="Text" Value="-" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="4" Text="{Binding HomeScore}" FontSize="14" FontWeight="Bold" MinWidth="14"
                               Margin="0,0,4,0" Style="{StaticResource HomeTeamText}" />
                    <TextBlock Grid.Column="5" Text="{Binding HomeAbbrev}" FontSize="13" Style="{StaticResource HomeTeamText}" />
                    <Image Grid.Column="6" Source="{Binding HomeLogo}" Width="18" Height="18" Margin="2,0,0,0"
                           Style="{StaticResource TeamLogo}" />

                    <TextBlock Grid.Column="8" Text="{Binding StatusText}" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="11.5" Style="{StaticResource GameStatusText}" />
                </Grid>

                <TextBlock Text="{Binding HatTrickText}" FontSize="10.5" Margin="0,2,0,0" Style="{StaticResource HatTrickText}" />

                <TextBlock Text="{Binding CountryText}" FontSize="10.5" Margin="0,2,0,0" Style="{StaticResource CountryText}"
                           Visibility="{Binding HasCountryText, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding WatchText}" FontSize="10.5" Margin="0,2,0,0" Style="{StaticResource WatchText}"
                           Visibility="{Binding HasWatchText, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{Binding ShotsText}" FontSize="10.5" Margin="0,1,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           Visibility="{Binding ShowShots, Converter={StaticResource BoolToVisibility}}" />

                <!-- Details (click the card): goals and actions. -->
                <StackPanel Margin="0,4,0,3" Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVisibility}}">
                    <controls:GoalList FontSize="11" Visibility="{Binding HasGoals, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <Button Style="{StaticResource SmallActionButton}" Content="{Binding ShieldActionLabel}"
                                Command="{Binding ToggleShieldCommand}" AutomationProperties.Name="{Binding ShieldActionLabel}" />
                        <Button Style="{StaticResource SmallActionButton}" Content="Focus" Margin="6,0,0,0"
                                Command="{Binding FocusCommand}" AutomationProperties.Name="Open focus dashboard"
                                ToolTip="Live dashboard: strength, shots, shot map and play-by-play" />
                        <Button Style="{StaticResource SmallActionButton}" Content="NHL.com" Margin="6,0,0,0"
                                Command="{Binding OpenGameCenterCommand}" AutomationProperties.Name="Open game page" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
