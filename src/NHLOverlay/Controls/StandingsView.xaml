<UserControl x:Class="NHLOverlay.Controls.StandingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NHLOverlay.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StandingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="TableTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="10,10,10,3" />
        </Style>

        <!-- One table (division or wildcard): rank, logo, team, GP, PTS, goal difference. -->
        <DataTemplate x:Key="TableTemplate" DataType="{x:Type vm:StandingsTable}">
            <StackPanel>
                <Grid Margin="10,10,10,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Title}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="GP" FontSize="10" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="2" Text="PTS" FontSize="10" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="3" Text="+/-" FontSize="10" TextAlignment="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StandingsRowViewModel}">
                            <Border x:Name="RowBorder" Padding="10,2" BorderThickness="0,0,0,0" BorderBrush="#664FB3FF" ToolTip="{Binding Name}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="36" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Rank}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Image Grid.Column="1" Source="{Binding Logo}" Width="16" Height="16" HorizontalAlignment="Left" />
                                    <TextBlock x:Name="Team" Grid.Column="2" Text="{Binding Abbrev}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding GamesPlayed}" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="Points" Grid.Column="4" Text="{Binding Points}" FontSize="12" FontWeight="SemiBold" TextAlignment="Right"
                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Column="5" Text="{Binding Differential}" FontSize="11.5" TextAlignment="Right" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="#1A4FB3FF" />
                                    <Setter TargetName="Team" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="Team" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                </DataTrigger>
                                <!-- Playoff cut line below the last team in a playoff spot. -->
                                <DataTrigger Binding="{Binding CutLineAfter}" Value="True">
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,0,0,1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,2,0,6">
        <TextBlock Text="{Binding Message}" Margin="10,6,10,6" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

        <!-- Favorite teams: race and next games. -->
        <ItemsControl ItemsSource="{Binding Favorites}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TeamSummaryViewModel}">
                    <Border Margin="6,4,6,2" Padding="8,6" CornerRadius="6" Background="#1A4FB3FF">
                        <StackPanel>
                            <DockPanel>
                                <Image Source="{Binding Logo}" Width="28" Height="28" Margin="0,0,8,0" DockPanel.Dock="Left" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                        <Run x:Name="PositionRun" Text="{Binding Position, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource StatusLiveBrush}" />
                                        <Run Text="{Binding Race, Mode=OneWay, StringFormat='  {0}'}" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </TextBlock>
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Text="{Binding RecordLine}" FontSize="11.5" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding FormLine}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel Margin="0,4,0,0" Visibility="{Binding HasNextGames, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="NEXT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
                                <ItemsControl ItemsSource="{Binding NextGames}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="11.5" Typography.NumeralAlignment="Tabular" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding InPlayoffSpot}" Value="False">
                            <Setter TargetName="PositionRun" Property="Foreground" Value="{StaticResource StatusOvertimeBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Playoff bracket (only while it is in use). -->
        <StackPanel Visibility="{Binding HasSeries, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="PLAYOFFS" Style="{StaticResource TableTitle}" />
            <ItemsControl ItemsSource="{Binding Series}" Focusable="False" Margin="10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="11.5" Typography.NumeralAlignment="Tabular" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Divisions}" ItemTemplate="{StaticResource TableTemplate}" Focusable="False" />
        <ItemsControl ItemsSource="{Binding Wildcards}" ItemTemplate="{StaticResource TableTemplate}" Focusable="False" />
    </StackPanel>
</UserControl>
