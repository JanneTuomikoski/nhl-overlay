<UserControl x:Class="NHLOverlay.Controls.GoalList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NHLOverlay.ViewModels"
             xmlns:controls="clr-namespace:NHLOverlay.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GameCardViewModel}">
    <!-- Columns line up across rows via shared size groups. -->
    <ItemsControl ItemsSource="{Binding Goals}" Grid.IsSharedSizeScope="True" Focusable="False">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:GoalLine}">
                <Grid Margin="0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Period" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Time" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Team" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Tags" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Score" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Period}" Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"
                               Typography.NumeralAlignment="Tabular" />
                    <TextBlock Grid.Column="2" Text="{Binding Team}" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="{Binding Scorer}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4" Text="{Binding Tags}" Margin="6,0,0,0" FontWeight="SemiBold"
                               Foreground="{StaticResource StatusOvertimeBrush}" />
                    <TextBlock Grid.Column="5" Text="{Binding Score}" Margin="8,0,0,0" TextAlignment="Right"
                               Foreground="{StaticResource TextSecondaryBrush}" Typography.NumeralAlignment="Tabular" />
                    <!-- Assists under the scorer (expanded view, when switched on). -->
                    <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3" Text="{Binding Assists}" FontSize="10.5"
                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasAssists}" Value="True" />
                                            <Condition Binding="{Binding ShowAssists, RelativeSource={RelativeSource AncestorType=controls:GoalList}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
