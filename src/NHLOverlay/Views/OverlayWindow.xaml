<Window x:Class="NHLOverlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:NHLOverlay.Controls"
        xmlns:vm="clr-namespace:NHLOverlay.ViewModels"
        xmlns:models="clr-namespace:NHLOverlay.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:OverlayViewModel}"
        Title="NHL Live Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True">

    <Window.Resources>
        <DataTemplate x:Key="CompactCardTemplate">
            <controls:GameCard />
        </DataTemplate>
        <DataTemplate x:Key="ExpandedCardTemplate">
            <controls:ExpandedGameCard />
        </DataTemplate>
        <!-- In-overlay notification; click to dismiss (interaction mode). -->
        <DataTemplate x:Key="ToastTemplate" DataType="{x:Type vm:ToastViewModel}">
            <Border Margin="6,0,6,4" CornerRadius="6" Background="#F21A212B" BorderBrush="#33FFFFFF" BorderThickness="1"
                    Cursor="Hand" ToolTip="Click to dismiss">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DismissCommand}" />
                </Border.InputBindings>
                <Grid>
                    <Rectangle x:Name="Accent" Width="3" HorizontalAlignment="Left" RadiusX="1.5" RadiusY="1.5" Margin="0,3"
                               Fill="{StaticResource AccentBrush}" />
                    <StackPanel Margin="10,5,8,6">
                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Body}" FontSize="11" Margin="0,1,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GameEventKind.Goal}">
                    <Setter TargetName="Accent" Property="Fill" Value="{StaticResource StatusLiveBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GameEventKind.HatTrickWatch}">
                    <Setter TargetName="Accent" Property="Fill" Value="{StaticResource HatTrickBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GameEventKind.HatTrickCompleted}">
                    <Setter TargetName="Accent" Property="Fill" Value="{StaticResource HatTrickBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GameEventKind.Overtime}">
                    <Setter TargetName="Accent" Property="Fill" Value="{StaticResource StatusOvertimeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GameEventKind.WorthWatching}">
                    <Setter TargetName="Accent" Property="Fill" Value="{StaticResource StatusErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:GameEventKind.GameFinal}">
                    <Setter TargetName="Accent" Property="Fill" Value="{StaticResource StatusFinalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInteractive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Width="300" CornerRadius="10" BorderThickness="1">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Border.LayoutTransform>
        <Border.Background>
            <SolidColorBrush Color="{StaticResource OverlayBackgroundColor}" Opacity="{Binding BackgroundOpacity}" />
        </Border.Background>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource OverlayBorderBrush}" />
                <Style.Triggers>
                    <!-- A subtle accent outline signals that the overlay is accepting mouse input. -->
                    <DataTrigger Binding="{Binding IsInteractive}" Value="True">
                        <Setter Property="BorderBrush" Value="#804FB3FF" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header doubles as the drag handle. -->
            <Grid x:Name="Header" Background="Transparent" Margin="6,4,5,3" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource HeaderIconButton}" Content="&#xE76B;" FontSize="9"
                        ToolTip="Previous day" AutomationProperties.Name="Previous day" Command="{Binding PreviousDayCommand}" />
                <Button Grid.Column="1" Style="{StaticResource IconButton}" FontFamily="{StaticResource UiFont}" FontSize="11"
                        FontWeight="Bold" Padding="2,0" Command="{Binding TodayCommand}" ToolTip="Back to today"
                        AutomationProperties.Name="Viewed day">
                    <TextBlock Text="{Binding DayLabel}" Margin="4,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsViewingToday}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
                <Button Grid.Column="2" Style="{StaticResource HeaderIconButton}" Content="&#xE76C;" FontSize="9"
                        ToolTip="Next day" AutomationProperties.Name="Next day" Command="{Binding NextDayCommand}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" ToolTip="Gaming profile active"
                               Visibility="{Binding IsGaming, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="#33F5B841" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" ToolTip="Do not disturb: alerts are held"
                            Visibility="{Binding IsDoNotDisturb, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="DND" FontSize="10" FontWeight="Bold" Foreground="{StaticResource HatTrickBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent"
                            Margin="6,0,0,0" ToolTip="{Binding StatusToolTip}">
                    <Ellipse Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusInactiveBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Ok}">
                                        <Setter Property="Fill" Value="{StaticResource StatusLiveBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Stale}">
                                        <Setter Property="Fill" Value="{StaticResource StatusStaleBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Connection}" Value="{x:Static vm:ConnectionState.Error}">
                                        <Setter Property="Fill" Value="{StaticResource StatusErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               Typography.NumeralAlignment="Tabular" />
                </StackPanel>

                <Button Grid.Column="5" Margin="6,0,0,0" Command="{Binding ToggleDisplayModeCommand}"
                        ToolTip="Switch between compact and expanded view" AutomationProperties.Name="Toggle expanded view">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource HeaderIconButton}">
                            <Setter Property="Content" Value="&#xE740;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="Content" Value="&#xE73F;" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="6" Style="{StaticResource HeaderIconButton}" Content="&#xE713;" Margin="2,0,0,0"
                        ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click" />
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource CardDividerBrush}" />

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}" Focusable="False"
                          Margin="0,4,0,0">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastsAtBottom}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>

            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False" Margin="0,2,0,6">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding Games}" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemTemplate" Value="{StaticResource CompactCardTemplate}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ExpandedCardTemplate}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="3" Text="{Binding Message}" Margin="10,6,10,10" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

            <ItemsControl Grid.Row="4" ItemsSource="{Binding Toasts}" ItemTemplate="{StaticResource ToastTemplate}" Focusable="False"
                          Margin="0,0,0,6" Visibility="{Binding ToastsAtBottom, Converter={StaticResource BoolToVisibility}}" />

            <!-- Width resize grip (interaction mode, position not locked). -->
            <Thumb x:Name="ResizeGrip" Grid.Row="3" Grid.RowSpan="2" Width="14" Height="14" Margin="0,0,1,1" Cursor="SizeWE"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   DragStarted="ResizeGrip_DragStarted" DragDelta="ResizeGrip_DragDelta" DragCompleted="ResizeGrip_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 11,3 L 3,11 M 11,7 L 7,11" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.2" />
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
                <Thumb.Style>
                    <Style TargetType="Thumb">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInteractive}" Value="True" />
                                    <Condition Binding="{Binding IsLocked}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Thumb.Style>
            </Thumb>
        </Grid>
    </Border>
</Window>
