<Window x:Class="NHLOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NHLOverlay.ViewModels"
        xmlns:controls="clr-namespace:NHLOverlay.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="NHL Live Overlay - Settings"
        Width="780" Height="620" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
        <Style TargetType="controls:HotkeyBox" BasedOn="{StaticResource ReadOnlyField}">
            <Setter Property="Width" Value="180" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Style="{StaticResource NavTabControl}">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource NavTabItem}" />
            </TabControl.Resources>

            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="General" Style="{StaticResource SectionHeader}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchWithWindows}"
                                  Content="Launch with Windows" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowOverlayOnStartup}"
                                  Content="Show the overlay on startup (otherwise start in the tray)" />

                        <TextBlock Text="Refresh interval (seconds)" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding RefreshIntervals}"
                                 SelectedItem="{Binding RefreshIntervalSeconds}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Used while games are live. When nothing is live, scores are checked less often until shortly before the next game starts." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Teams">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Teams}">
                    <StackPanel>
                        <TextBlock Text="Teams" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Pick your favorite teams. Their games are highlighted, listed first and used for notifications." />

                        <ItemsControl ItemsSource="{Binding TeamGroups}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource FieldLabel}" Margin="0,8,0,6" />
                                        <ItemsControl ItemsSource="{Binding Teams}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource TeamChip}" IsChecked="{Binding IsFavorite}"
                                                                  ToolTip="{Binding FullName}" AutomationProperties.Name="{Binding FullName}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Source="{Binding Logo}" Width="20" Height="20" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Abbrev}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource DarkButton}" Content="Clear favorites" HorizontalAlignment="Left"
                                Margin="0,6,0,0" Command="{Binding ClearFavoritesCommand}" />

                        <TextBlock Text="Show in today's view" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding FilterOptions}" DisplayMemberPath="Label"
                                 SelectedValuePath="Value" SelectedValue="{Binding Filter}" />

                        <TextBlock Text="Order" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                                 SelectedValuePath="Value" SelectedValue="{Binding SortOrder}" />

                        <TextBlock Text="Favorite highlight" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding HighlightOptions}" DisplayMemberPath="Label"
                                 SelectedValuePath="Value" SelectedValue="{Binding Highlight}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Hat-Trick Watch">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding HatTrick}">
                    <StackPanel>
                        <TextBlock Text="Hat-Trick Watch" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="Flags players with two goals in a game, then the completed hat trick. Counts come from the game's own goal list; shootout goals never count." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" Content="Enable Hat-Trick Watch" />

                        <TextBlock Text="Watch" Style="{StaticResource FieldLabel}" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Label"
                                 SelectedValuePath="Value" SelectedValue="{Binding Scope}" IsEnabled="{Binding Enabled}" />

                        <TextBlock Text="Display" Style="{StaticResource FieldLabel}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding HighlightCards}" IsEnabled="{Binding Enabled}"
                                  Content="Highlight the game card in amber" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowPlayerName}" IsEnabled="{Binding Enabled}"
                                  Content="Show the player's name" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="Alerts for two-goal players and completed hat tricks are set on the Notifications tab." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Notifications">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Notifications}">
                    <StackPanel>
                        <TextBlock Text="Notifications" Style="{StaticResource SectionHeader}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" Content="Enable notifications" />

                        <Grid Grid.IsSharedSizeScope="True" Margin="0,10,0,0" IsEnabled="{Binding Enabled}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.Resources>
                                <Style x:Key="ColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </Grid.Resources>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Test" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Event" Style="{StaticResource ColumnHeader}" TextAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="On" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="2" Text="Favorites only" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="3" Text="Overlay" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="4" Text="Windows" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="5" Text="Sound" Style="{StaticResource ColumnHeader}" />
                                <TextBlock Grid.Column="6" Text="Voice" Style="{StaticResource ColumnHeader}" />
                            </Grid>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rules}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="Test" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" ToolTip="{Binding Description}" VerticalAlignment="Center" />
                                            <CheckBox Grid.Column="1" Style="{StaticResource MatrixCheck}" IsChecked="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} enabled'}" />
                                            <CheckBox Grid.Column="2" Style="{StaticResource MatrixCheck}" IsChecked="{Binding FavoritesOnly}" IsEnabled="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} favorites only'}" />
                                            <CheckBox Grid.Column="3" Style="{StaticResource MatrixCheck}" IsChecked="{Binding Overlay}" IsEnabled="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} overlay'}" />
                                            <CheckBox Grid.Column="4" Style="{StaticResource MatrixCheck}" IsChecked="{Binding Desktop}" IsEnabled="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} Windows notification'}" />
                                            <CheckBox Grid.Column="5" Style="{StaticResource MatrixCheck}" IsChecked="{Binding Sound}" IsEnabled="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} sound'}" />
                                            <CheckBox Grid.Column="6" Style="{StaticResource MatrixCheck}" IsChecked="{Binding Speech}" IsEnabled="{Binding Enabled}"
                                                      AutomationProperties.Name="{Binding Label, StringFormat='{}{0} voice'}" />
                                            <Button Grid.Column="7" Style="{StaticResource DarkButton}" Content="Test" MinWidth="0" Padding="10,2"
                                                    Margin="6,0,0,0" Command="{Binding TestCommand}"
                                                    AutomationProperties.Name="{Binding Label, StringFormat='Test {0}'}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Alerts never replay old events: on startup and at the morning rollover the current state is only recorded. Hover an event name for details." />

                        <TextBlock Text="Overlay toasts" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource DarkSlider}" Minimum="3" Maximum="30" Value="{Binding ToastSeconds}" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding ToastSeconds, StringFormat={}{0:0} s}" />
                        </Grid>
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding PlacementOptions}" DisplayMemberPath="Label" Margin="0,8,0,0"
                                 SelectedValuePath="Value" SelectedValue="{Binding Placement}" />

                        <TextBlock Text="Sounds" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SoundsEnabled}" Content="Play notification sounds" />
                        <Grid IsEnabled="{Binding SoundsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100" Value="{Binding SoundVolumePercent}"
                                    AutomationProperties.Name="Sound volume" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SoundVolumePercent, StringFormat={}{0:0} %}" />
                        </Grid>

                        <TextBlock Text="Voice" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SpeechEnabled}" Content="Speak alerts (Windows text-to-speech)"
                                  IsEnabled="{Binding SpeechAvailable}" />
                        <StackPanel IsEnabled="{Binding SpeechEnabled}">
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding Voices}" SelectedItem="{Binding Voice}" Margin="0,4,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Slider Grid.Column="1" Style="{StaticResource DarkSlider}" Minimum="-5" Maximum="5" IsSnapToTickEnabled="True"
                                        TickFrequency="1" Value="{Binding SpeechRate}" AutomationProperties.Name="Voice speed" />
                                <TextBlock Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SpeechRate}" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Choose which events are spoken in the Voice column above." />

                        <TextBlock Text="Quiet hours" Style="{StaticResource FieldLabel}" Margin="0,18,0,0" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding QuietHoursEnabled}"
                                  Content="Mute sounds and voice during quiet hours (toasts still show)" />
                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding QuietHoursEnabled}">
                            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Width="70" Text="{Binding QuietFrom, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Quiet hours from" />
                            <TextBlock Text="to" VerticalAlignment="Center" Margin="10,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Width="70" Text="{Binding QuietTo, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Quiet hours to" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Gaming">
                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding Gaming}">
                    <StackPanel>
                        <TextBlock Text="Gaming profile" Style="{StaticResource SectionHeader}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                   Text="When one of these games is the active window, the overlay switches to your gaming setup. Only the active window's process name is checked; no game files or memory are touched." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" Content="Enable the gaming profile" />

                        <StackPanel IsEnabled="{Binding Enabled}">
                            <TextBlock Text="Games (process names, comma separated)" Style="{StaticResource FieldLabel}" />
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding GameProcesses, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Game process names" />
                            <DockPanel Margin="0,12,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="Refresh" MinWidth="0" Padding="10,2"
                                        Command="{Binding RefreshAppsCommand}" />
                                <TextBlock Text="Running apps (click to add)" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding RunningApps}" SelectedItem="{Binding SelectedRunningApp}" />

                            <TextBlock Text="While gaming" Style="{StaticResource FieldLabel}" Margin="0,18,0,6" />
                            <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding DisplayModeOptions}" DisplayMemberPath="Label"
                                     SelectedValuePath="Value" SelectedValue="{Binding DisplayMode}" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough}" Margin="0,10,0,6"
                                      Content="Click-through (the interaction hotkey still lets you click the overlay)" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Sounds}" Content="Play sounds" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Speech}" Content="Speak alerts" />
                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DesktopNotifications}"
                                      Content="Show Windows notifications (they can pop over the game)" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="Tip: the Do Not Disturb hotkey (default Ctrl+Alt+D) holds all alerts, for example during a raid boss, and shows a summary when you switch it off." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="View" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <ListBox Style="{StaticResource ChipList}" ItemsSource="{Binding DisplayModes}"
                                 SelectedItem="{Binding DisplayMode}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Expanded shows logos, team names, shots and every goal; good for a large or vertical monitor. Also toggled from the overlay header or the tray." />

                        <TextBlock Text="Background opacity" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource DarkSlider}" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                    Value="{Binding BackgroundOpacityPercent}" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding BackgroundOpacityPercent, StringFormat={}{0:0} %}" />
                        </Grid>

                        <TextBlock Text="UI scale" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource DarkSlider}" Minimum="{Binding MinUiScalePercent, Mode=OneTime}"
                                    Maximum="{Binding MaxUiScalePercent, Mode=OneTime}" SmallChange="5" LargeChange="25"
                                    Value="{Binding UiScalePercent}" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" VerticalAlignment="Center"
                                       Text="{Binding UiScalePercent, StringFormat={}{0:0} %}" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Tip: hold Ctrl and use the mouse wheel over the overlay to scale it, and drag its bottom-right corner to change the width." />

                        <TextBlock Text="Game cards" Style="{StaticResource FieldLabel}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowTeamLogos}"
                                  Content="Show team logos" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowGameClock}"
                                  Content="Show the game clock" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowShotsOnGoal}"
                                  Content="Show shots on goal in compact view" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Overlay">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Overlay window" Style="{StaticResource SectionHeader}" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ClickThrough}"
                                  Content="Click-through (mouse input goes to the game underneath)" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                   Text="In click-through mode the overlay's buttons are hidden. Use the interaction hotkey or the tray menu to switch back." />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AlwaysOnTop}"
                                  Content="Always on top" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LockPosition}"
                                  Content="Lock position and size" />
                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SnapToEdges}"
                                  Content="Snap to screen edges when dragged" />

                        <TextBlock Text="Global hotkeys" Style="{StaticResource FieldLabel}" Margin="0,22,0,6" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Click a box and press the new combination (Ctrl, Alt or Win required). Backspace clears it. Hotkeys are paused while this window is open." />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="2" Text="Do not disturb" VerticalAlignment="Center" Margin="0,8,16,0" />
                            <controls:HotkeyBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" AutomationProperties.Name="Do not disturb hotkey"
                                                Text="{Binding ToggleDoNotDisturbHotkey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Show / hide overlay" VerticalAlignment="Center" Margin="0,0,16,8" />
                            <controls:HotkeyBox Grid.Column="1" Margin="0,0,0,8" AutomationProperties.Name="Show or hide overlay hotkey"
                                                Text="{Binding ToggleOverlayHotkey, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="Toggle interaction mode" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <controls:HotkeyBox Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Toggle interaction mode hotkey"
                                                Text="{Binding ToggleInteractionHotkey, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <TextBlock Text="{Binding HotkeyProblems}" Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Foreground="{StaticResource StatusStaleBrush}"
                                   Visibility="{Binding HasHotkeyProblems, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Advanced" Style="{StaticResource SectionHeader}" />

                        <TextBlock Text="NHL API status" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ApiStatus}" Style="{StaticResource ValueText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ApiEndpoint}" Style="{StaticResource Hint}" Margin="0" />

                        <TextBlock Text="Last successful refresh" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding LastSuccessText}" Style="{StaticResource ValueText}" />

                        <TextBlock Text="Last API error" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource ValueText}" />

                        <Button Style="{StaticResource DarkButton}" Content="Refresh now" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Command="{Binding RefreshNowCommand}" />

                        <TextBlock Text="Settings file" Style="{StaticResource FieldLabel}" Margin="0,24,0,6" />
                        <TextBlock Text="{Binding StorageMode}" Style="{StaticResource ValueText}" />
                        <TextBox Style="{StaticResource ReadOnlyField}" Text="{Binding SettingsPath, Mode=OneWay}" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding LoadWarning}" Style="{StaticResource Hint}" Foreground="{StaticResource StatusStaleBrush}"
                                   Visibility="{Binding HasLoadWarning, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource DarkButton}" Content="Open folder" Margin="0,0,8,0"
                                    Command="{Binding OpenSettingsFolderCommand}" />
                            <Button Style="{StaticResource DarkButton}" Content="Reset to defaults"
                                    Command="{Binding ResetCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DarkButton}" Content="Cancel" IsCancel="True" Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button Style="{StaticResource AccentButton}" Content="Save" IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
