<Window x:Class="NHLOverlay.Views.FocusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:NHLOverlay.ViewModels"
        xmlns:services="clr-namespace:NHLOverlay.Services"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FocusViewModel}"
        Title="{Binding Title}"
        Width="460" Height="940" MinWidth="320" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Topmost="{Binding AlwaysOnTop}"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AwayBrush" Color="#C9D3DD" />
        <SolidColorBrush x:Key="HomeBrush" Color="#4FB3FF" />
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource MatrixCheck}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="14,10,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Score header -->
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" MinWidth="44" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image Source="{Binding AwayLogo}" Width="44" Height="44" Margin="0,2,12,2" />
                <TextBlock Grid.Column="1" Text="{Binding AwayName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding AwayShots}" FontSize="12" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding AwayScore}" FontSize="34" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                <Image Grid.Row="1" Source="{Binding HomeLogo}" Width="44" Height="44" Margin="0,2,12,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HomeName}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HomeShots}" FontSize="12" Margin="10,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding HomeScore}" FontSize="34" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding StatusText}" FontSize="15" Margin="0,6,0,0" Style="{StaticResource GameStatusText}" />
        </StackPanel>

        <!-- Strength strip: power play / pulled goalie -->
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,6" CornerRadius="6" Background="#33FB923C"
                Visibility="{Binding ShowStrength, Converter={StaticResource BoolToVisibility}}">
            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource StatusOvertimeBrush}">
                <Run Text="{Binding Strength, Mode=OneWay}" /><Run Text="{Binding StrengthDetail, Mode=OneWay, StringFormat='  {0}'}" FontWeight="Normal" />
            </TextBlock>
        </Border>

        <!-- Shots per period and the shot map -->
        <StackPanel Grid.Row="2" Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="SHOTS BY PERIOD" Style="{StaticResource Section}" />
            <ItemsControl ItemsSource="{Binding Periods}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PeriodBar}">
                        <StackPanel Margin="0,0,18,0">
                            <Grid Height="62">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Away}" FontSize="11" HorizontalAlignment="Center" />
                                        <Rectangle Width="16" Height="{Binding AwayHeight}" Fill="{StaticResource AwayBrush}" RadiusX="2" RadiusY="2" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding Home}" FontSize="11" HorizontalAlignment="Center" />
                                        <Rectangle Width="16" Height="{Binding HomeHeight}" Fill="{StaticResource HomeBrush}" RadiusX="2" RadiusY="2" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Label}" FontSize="10.5" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <DockPanel Margin="0,12,0,4">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AwayBrush}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding AwayAbbrev}" FontSize="10.5" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Ellipse Width="8" Height="8" Fill="{StaticResource HomeBrush}" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding HomeAbbrev}" FontSize="10.5" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                    <Ellipse Width="10" Height="10" Stroke="{StaticResource HatTrickBrush}" StrokeThickness="2" Margin="0,0,4,0" />
                    <TextBlock Text="goal" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
                <TextBlock Text="SHOT MAP" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" />
            </DockPanel>

            <!-- Rink in NHL coordinates (200 x 85 ft); the Viewbox scales it to the window width. -->
            <Viewbox Stretch="Uniform">
                <Grid Width="200" Height="85">
                    <Rectangle RadiusX="28" RadiusY="28" Stroke="#55FFFFFF" StrokeThickness="0.6" Fill="#0DFFFFFF" />
                    <Line X1="100" Y1="0" X2="100" Y2="85" Stroke="#88F87171" StrokeThickness="0.8" />
                    <Line X1="75" Y1="0" X2="75" Y2="85" Stroke="#884FB3FF" StrokeThickness="0.8" />
                    <Line X1="125" Y1="0" X2="125" Y2="85" Stroke="#884FB3FF" StrokeThickness="0.8" />
                    <Line X1="11" Y1="4" X2="11" Y2="81" Stroke="#66F87171" StrokeThickness="0.4" />
                    <Line X1="189" Y1="4" X2="189" Y2="81" Stroke="#66F87171" StrokeThickness="0.4" />
                    <Ellipse Width="30" Height="30" Stroke="#554FB3FF" StrokeThickness="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="85,27.5,0,0" />
                    <Ellipse Width="30" Height="30" Stroke="#44F87171" StrokeThickness="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,5.5,0,0" />
                    <Ellipse Width="30" Height="30" Stroke="#44F87171" StrokeThickness="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,49.5,0,0" />
                    <Ellipse Width="30" Height="30" Stroke="#44F87171" StrokeThickness="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="154,5.5,0,0" />
                    <Ellipse Width="30" Height="30" Stroke="#44F87171" StrokeThickness="0.4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="154,49.5,0,0" />
                    <Path Data="M 11,38.5 A 6,6 0 0 1 11,46.5" Stroke="#664FB3FF" StrokeThickness="0.5" Fill="#224FB3FF" />
                    <Path Data="M 189,38.5 A 6,6 0 0 0 189,46.5" Stroke="#664FB3FF" StrokeThickness="0.5" Fill="#224FB3FF" />

                    <ItemsControl ItemsSource="{Binding Shots}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ShotDot}">
                                <Ellipse x:Name="Dot" Width="{Binding Size}" Height="{Binding Size}" Fill="{StaticResource HomeBrush}"
                                         ToolTip="{Binding Description}" Opacity="0.85" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAway}" Value="True">
                                        <Setter TargetName="Dot" Property="Fill" Value="{StaticResource AwayBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsGoal}" Value="True">
                                        <Setter TargetName="Dot" Property="Stroke" Value="{StaticResource HatTrickBrush}" />
                                        <Setter TargetName="Dot" Property="StrokeThickness" Value="1" />
                                        <Setter TargetName="Dot" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMiss}" Value="True">
                                        <Setter TargetName="Dot" Property="Opacity" Value="0.35" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Viewbox>
        </StackPanel>

        <!-- Event feed (newest first) -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="PLAY BY PLAY" Style="{StaticResource Section}" Margin="0,4,0,4"
                       Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Grid.Row="1" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
                <Button Style="{StaticResource DarkButton}" Content="Reveal score" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Command="{Binding RevealCommand}" Visibility="{Binding IsShielded, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBar}" />
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding Feed}" Focusable="False" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type services:FeedItem}">
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="When" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Team" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding When}" FontSize="11.5" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Grid.Column="1" Text="{Binding Team}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,10,0" />
                                <TextBlock x:Name="Text" Grid.Column="2" Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:FeedKind.Goal}">
                                    <Setter TargetName="Text" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource StatusLiveBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:FeedKind.Penalty}">
                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource StatusOvertimeBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:FeedKind.Goalie}">
                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource HatTrickBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:FeedKind.Period}">
                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    <Setter TargetName="Text" Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:FeedKind.Shot}">
                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static services:FeedKind.Hit}">
                                    <Setter TargetName="Text" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Options -->
        <WrapPanel Grid.Row="4" Margin="0,10,0,0">
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowShotsInFeed}" AutomationProperties.Name="Shots in feed" />
            <TextBlock Text="Shots" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowHitsInFeed}" AutomationProperties.Name="Hits in feed" />
            <TextBlock Text="Hits" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding ShowMissedShots}" AutomationProperties.Name="Missed shots on map" />
            <TextBlock Text="Missed shots on map" FontSize="11.5" Margin="0,0,14,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
            <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding AlwaysOnTop}" AutomationProperties.Name="Always on top" />
            <TextBlock Text="Always on top" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
        </WrapPanel>
    </Grid>
</Window>
